# Independent temporary migration service, not the website Dockerfile.
FROM node:24-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY scripts/amvera-migrate.mjs ./scripts/amvera-migrate.mjs
COPY migrations/amvera ./migrations/amvera
USER node
# Offline build smoke: verifies pg import and baseline availability, no DB access.
RUN node scripts/amvera-migrate.mjs --plan
CMD ["node", "scripts/amvera-migrate.mjs", "--plan"]
